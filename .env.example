# GROQ API Key for LLM-powered intent parsing
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Frontend -------------------------------------------------------------
# Where the dashboard reaches the API. Leave unset to use the origin the
# dashboard is served from (with :8000 substituted during Vite dev).
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws

# --- Backend (all optional; defaults shown) -------------------------------
# HELIX_TOTAL_BANDWIDTH_MBPS=1000
# HELIX_FORCE_RULE_PARSER=false    # skip the LLM even when a key is present
# HELIX_PERSISTENCE_ENABLED=true
# HELIX_DATABASE_PATH=backend/data/helix.db
# HELIX_TELEMETRY_ENABLED=true
# HELIX_TELEMETRY_INTERVAL=2.0
# HELIX_RATE_LIMIT_PER_MINUTE=60
# HELIX_SDN_STEP_SCALE=1.0         # 0 makes deployments instant
# HELIX_LOG_JSON=false

# --- Authentication (optional; unset = every request is fully privileged) --
# Comma-separated "key:scope[:label]" entries. scope is "read" or "write"
# (write implies read). label appears as the actor in the audit journal and
# defaults to a redacted, non-reversible form of the key if omitted.
# HELIX_API_KEYS=sk_live_replace_me:write:ops-team,sk_live_viewer:read:dashboard
